{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/server.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "redirects": [
    { "source": "/admin.html", "destination": "/dashboard", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/(product|blog|guides|sitemap\\.xml)(/.*)?", "destination": "/api/server.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
